---
import type { NavLink, CtaButton } from "../../lib/types";

interface Props {
  links: NavLink[];
  currentPath?: string;
  cta?: CtaButton;
}

const { links, cta, currentPath = "" } = Astro.props;
---

<div id="mobile-nav-root" class="lg:hidden">
  <div
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    data-open="false"
    inert
    class="group/menu fixed inset-x-0 bottom-0 top-19 z-100 flex translate-x-full flex-col overflow-y-auto overscroll-contain bg-white shadow-2xl transition-transform duration-300 ease-out will-change-transform data-[open=true]:translate-x-0 motion-reduce:transition-none"  
    >

    <!-- Links -->
    <nav aria-label="Mobile Navigation" class="px-3 pt-4 sm:px-4">
      <ul>
        {links.map((item) => {
          const isActive = item.url === currentPath;
          const linkColor = isActive
            ? "font-semibold text-[#004681]"
            : "font-semibold text-[#2C2C2C] hover:text-[#004681]";

          const row =
            "group/row flex min-h-16 items-center rounded-xl px-2 text-lg transition-colors duration-200 ease-out focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#004681] motion-reduce:transition-none";

          if (!item.children || item.children.length === 0) {
            return (
              <li class="border-b border-[#E9EDF2]">
                <a
                  href={item.url}
                  aria-current={isActive ? "page" : undefined}
                  class:list={[row, linkColor]}
                >
                  {item.label}
                </a>
              </li>
            );
          }

          return (
            <li class="border-b border-[#E9EDF2]">
              <details class="accordion group/accordion">
                <summary
                  class:list={[
                    row,
                    linkColor,
                    "cursor-pointer list-none justify-between [&::-webkit-details-marker]:hidden",
                  ]}
                >
                  <span>{item.label}</span>
                  <span
                    aria-hidden="true"
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#EEF2F7] text-primary"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      class="transition-transform duration-300 ease-out group-open/accordion:rotate-45 motion-reduce:transition-none"
                    >
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                    </svg>
                  </span>
                </summary>

                <ul class="mb-3 ml-3 space-y-0.5 border-l border-[#E9EDF2] pl-4">
                  {item.children?.map((entry) => (
                    <li>
                      {entry.children && entry.children.length > 0 ? (
                        <details class="accordion group/nested">
                          <summary class="group/sub flex cursor-pointer list-none items-center justify-between rounded-lg px-2 py-2.5 text-base text-[#4B5563] transition-colors duration-700 ease-out hover:text-primary focus-visible:outline focus-visible:-outline-offset-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
                            <span class="inline-block transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/sub:translate-x-2 motion-reduce:transition-none motion-reduce:transform-none">
                              {entry.label}
                            </span>
                            <span
                              aria-hidden="true"
                              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#EEF2F7] text-primary"
                            >
                              <svg
                                viewBox="0 0 24 24"
                                width="18"
                                height="18"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                class="transition-transform duration-300 ease-out [details[open]>summary_&]:rotate-45 motion-reduce:transition-none"
                              >
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                              </svg>
                            </span>
                          </summary>

                          <ul class="mb-1 ml-2 space-y-0.5 border-l border-[#E9EDF2] pl-4">
                            <!-- Keeps the parent page reachable, since the row itself now only toggles -->
                            {entry.children.map((child) => (
                              <li>
                                <a
                                  href={child.url}
                                  class="group/sub block rounded-lg px-2 py-2 text-[15px] text-[#4B5563] transition-colors duration-700 ease-out hover:text-primary focus-visible:outline focus-visible:-outline-offset-2 focus-visible:outline-primary"
                                >
                                  <span class="inline-block transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/sub:translate-x-2 group-focus-visible/sub:translate-x-2 motion-reduce:transition-none motion-reduce:transform-none">
                                    {child.label}
                                  </span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </details>
                      ) : (
                        <a
                          href={entry.url}
                          class="group/sub block rounded-lg px-2 py-2.5 text-base text-[#4B5563] transition-colors duration-700 ease-out hover:text-primary focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary"
                        >
                          <span class="inline-block transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/sub:translate-x-2 group-focus-visible/sub:translate-x-2 motion-reduce:transition-none motion-reduce:transform-none">
                            {entry.label}
                          </span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- CTA -->
    {cta && (
      <div class="px-5 pb-10 pt-8 sm:px-6">
        <a
          href={cta.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group/cta flex h-14 w-full items-center justify-between rounded-full bg-[#004681] px-7 text-base font-semibold text-white shadow-[0_12px_28px_-10px_rgba(0,70,129,0.55)] transition-[background-color,box-shadow] duration-200 hover:bg-[#003a6b] hover:shadow-[0_16px_32px_-10px_rgba(0,70,129,0.6)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004681] motion-reduce:transition-none"
        >
          <span>{cta.label}</span>
          <span
            aria-hidden="true"
            class="text-xl leading-none transition-transform duration-200 group-hover/cta:translate-x-1 motion-reduce:transition-none"
          >
            →
          </span>
        </a>
      </div>
    )}
  </div>
</div>

<style>
  /* accordion open/close */
  .accordion {
    interpolate-size: allow-keywords;
  }
  .accordion::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.25s ease,
      content-visibility 0.25s allow-discrete;
  }
  .accordion[open]::details-content {
    block-size: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .accordion::details-content {
      transition: none;
    }
  }
</style>

<script>
  const menu = document.getElementById("mobile-menu");
  const openBtn = document.getElementById("mobile-menu-button");

  const menuIcon = openBtn!.querySelector(".menu-icon");
  const closeIcon = openBtn!.querySelector(".close-icon");

  if (menu && openBtn) {
    const desktop = window.matchMedia("(min-width: 1024px)");
    const FOCUSABLE = "a[href], button:not([disabled]), summary";
    let isOpen = false;
    let collapseTimer: number | undefined;

    function openMenu() {
      if (isOpen) return;
      window.clearTimeout(collapseTimer);
      isOpen = true;
      menu!.removeAttribute("inert");
      menu!.dataset.open = "true";
      document.body.classList.add("overflow-hidden");
      openBtn!.setAttribute("aria-expanded", "true");
      openBtn!.setAttribute("aria-label", "Close menu");
      menuIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");

      const firstFocusable = menu!.querySelector<HTMLElement>(
        "a[href], summary, button:not([disabled])",
      );

      firstFocusable?.focus({ preventScroll: true });
    }

    function closeMenu(restoreFocus = true) {
      if (!isOpen) return;
      isOpen = false;
      menu!.setAttribute("inert", "");
      menu!.dataset.open = "false";
      document.body.classList.remove("overflow-hidden");
      collapseTimer = window.setTimeout(() => {
        menu!
          .querySelectorAll("details[open]")
          .forEach((d) => d.removeAttribute("open"));
      }, 320);
      
      openBtn!.setAttribute("aria-expanded", "false");
      openBtn!.setAttribute("aria-label", "Open menu");
      menuIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");

      if (restoreFocus) openBtn!.focus({ preventScroll: true });
            
    }

    openBtn.addEventListener("click", () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) closeMenu(false);
    });

    document.addEventListener("keydown", (e) => {
      if (!isOpen) return;
      if (e.key === "Escape") {
        closeMenu();
        return;
      }
      if (e.key !== "Tab") return;
      const items = Array.from(
        menu.querySelectorAll<HTMLElement>(FOCUSABLE),
      ).filter((el) => el.offsetParent !== null);
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    desktop.addEventListener("change", (e) => {
      if (e.matches) closeMenu(false);
    });
  }
</script>
