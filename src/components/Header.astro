---
import type { SiteSettings } from '../lib/types';
import Button from './Button.astro';
import MobileNav from './MobileNav.astro';
import NavLinks from "./NavLinks.astro";

interface Props {
    settings: SiteSettings | null;
    currentPath?: string;
}

const { settings, currentPath = '' } = Astro.props;
const navLinks = settings?.navLinks ?? [];
const cta = settings?.headerCta;
---
<!--sm  → 640px-->
<!--md  → 768px-->
<!--lg  → 1024px -->

<header class="fixed inset-x-0 top-0 z-100 bg-white shadow-[0_1px_3px_rgba(0,0,0,0.06)]">
  <div class="mx-auto max-w-7xl lg:h-20 lg:px-6 h-19 flex justify-between items-center px-5 sm:px-6">
    <!-- Logo -->
    <a href="/" aria-label="Home" class="">
      <img
        src="https://cdn.sanity.io/images/5twaxtv5/production/dec60c1e06fa94ef47a1a489f73dfdcad5a59bf3-676x106.svg?w=400&auto=format"
        alt="RightDirect"
        width="220"
        height="70"
        class="lg:w-55 w-43.75 h-auto"
      />
    </a>

    <!-- Desktop nav -->
    <NavLinks links={navLinks} currentPath={currentPath} />

    <div class="cta-divider" data-astro-cid-nen7h5rs=""></div>

    <!-- Desktop CTA -->
    {cta && (
      <a
        href={cta.url}
        target="_blank"
        class="cta-reveal hidden items-center gap-1.5 whitespace-nowrap rounded-full bg-[#004681] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#003a6b] lg:flex"
      >
        {cta.label}
        <span aria-hidden="true">→</span>
      </a>
    )}

      <!-- Mobile menu trigger -->
      <button
        id="nav-toggle"
        type="button"
        class="lg:hidden flex h-11 w-11 items-center justify-center rounded-lg text-navy ml-auto"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
    >
        <svg width="24" height="24" viewBox="0 0 22 16" fill="none" aria-hidden="true">
            <path d="M1 1h20M1 8h20M1 15h20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
    </button>
      
  </div>

  <MobileNav cta={cta} links={navLinks} currentPath={currentPath} />
</header>

<style>
  .cta-reveal {
    overflow: hidden;
    white-space: nowrap;
    max-width: clamp(0px, calc((100vw - 1024px) * 0.92), 180px);
  }
</style>

<script>
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-nav');

    toggle?.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        menu?.classList.toggle('hidden');
        menu?.classList.toggle('flex');
    });
</script>