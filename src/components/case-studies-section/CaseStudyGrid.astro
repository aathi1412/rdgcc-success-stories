---
import type { CaseStudyCard as CaseStudyCardType } from "../../lib/types";
import CaseStudyCard from "./CaseStudyCard.astro";

interface Props {
  cards: CaseStudyCardType[];
}

const { cards } = Astro.props;
---

<section class="w-full bg-[#F4F4F4] px-6 py-16 md:px-10 lg:px-16">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 sm:gap-6 sm:grid-cols-2">
    {cards.map((card) => (
      <CaseStudyCard card={card} />
    ))}
  </div>
</section>
