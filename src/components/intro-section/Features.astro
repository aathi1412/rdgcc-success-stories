---
import type { Features as FeatureType } from "../../lib/types";
import FeaturesIcon from "./FeaturesIcon.astro";

interface Props {
  feature: FeatureType;
}

const { feature } = Astro.props;
---

<div class="bg-white rounded-3xl px-6 py-3 shadow-sm border border-slate-100 flex items-center gap-5">
  <div class="w-11 h-11 shrink-0 rounded-full bg-primary/10 flex items-center justify-center">
    <FeaturesIcon name={feature.icon} />
  </div>
  <div>
    <h3 class="text-xl font-semibold text-primary">{feature.title}</h3>
  </div>
</div>
