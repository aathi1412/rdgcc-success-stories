---
import type { SuccessStoriesPage } from '../lib/types';

interface Props {
  hero: SuccessStoriesPage['hero'];
}

const { hero } = Astro.props;
---

<section class="bg-hero text-white text-center mt-20 px-4 py-20">
  <div class="max-w-4xl mx-auto flex flex-col items-center">
    <div class="w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center mb-4" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        focusable="false"
        class="w-10 h-10 p-2 rounded-full shrink-0 text-white bg-[#336B9A]"
      >
        <path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"></path>
        <circle cx="12" cy="8" r="6"></circle>
      </svg>
    </div>

    <h1 class="text-3xl sm:text-4xl md:text-5xl tracking-tight mb-2 font-semibold font-heading text-white text-balance">
      {hero.title}
    </h1>

    {hero.subtitle && (
      <p class="text-base sm:text-lg md:text-xl font-medium text-[#f4f4f4] text-balance max-w-2xl">
        {hero.subtitle}
      </p>
    )}
  </div>
</section>