---
import type { SuccessStoriesPage } from '../lib/types';
import { urlFor } from '../lib/sanity';

interface Props {
  hero: SuccessStoriesPage['hero'];
}

const { hero } = Astro.props;
---
<section class="bg-hero text-white text-center py-20 px-4 mt-20 sm:py-16 md:py-20">
  <div class="mx-auto mb-4 sm:mb-5 flex h-8 w-8 sm:h-14 sm:w-14 bg-white/10 items-center justify-center rounded-full">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" stroke-width="1.5" class="lucide lucide-award w-10 h-10 mt-1 p-2 rounded-full shrink-0 text-white bg-[#336B9A]">
      <path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"></path>
      <circle cx="12" cy="8" r="6"></circle>
      </svg>
  </div>
  <h1 class="text-4xl sm:text-5xl md:text-5xl tracking-tight mb-2 font-semibold font-heading text-white">{hero.title}</h1>
  {hero.subtitle && 
    <p class="mt-3 md:text-xl text-lg sm:text-base font-medium text-[#f4f4f4]">{hero.subtitle}</p>
  }
</section>