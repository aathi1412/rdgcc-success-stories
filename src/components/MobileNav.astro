---
import type { NavLink, CtaButton } from '../lib/types';

interface Props {
  links: NavLink[];
  currentPath?: string;
  cta?: CtaButton;
}

const { links, cta, currentPath = ''} = Astro.props;
---

<div id="mobile-nav-root" class="lg:hidden">
  <!-- Backdrop -->
  <div
    id="mobile-backdrop"
    class="fixed inset-0 z-[90] hidden bg-black/40 opacity-0 transition-opacity duration-200"
  >
  </div>

  <!-- Slide-in panel -->
  <div
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    class="fixed inset-y-0 right-0 z-[100] flex h-full w-[85%] max-w-sm translate-x-full flex-col bg-white shadow-2xl transition-transform duration-300 ease-out"
  >
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
      <span class="text-sm font-semibold tracking-wide text-[#004681]">Menu</span>
      <button
        id="mobile-menu-close"
        type="button"
        aria-label="Close menu"
        class="rounded-full p-2 text-[#004681] transition-colors hover:bg-slate-100"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav aria-label="Mobile Navigation" class="flex-1 overflow-y-auto px-3 py-4">
      <ul class="space-y-1">
        {
          links.map((item) => {
            const isActive = item.url === currentPath;

            if (!item.children || item.children.length === 0) {
              return (
                <li>
                  <a
                    href={item.url}
                    aria-current={isActive ? "page" : undefined}
                    class:list={[
                      "block rounded-lg px-3 py-3 text-base",
                      isActive ? "font-bold text-[#004681]" : "font-medium text-[#2C2C2C]",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            }

            return (
              <li>
                <details class="group/accordion rounded-lg">
                  <summary
                    class:list={[
                      "flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-3 text-base [&::-webkit-details-marker]:hidden",
                      isActive ? "font-bold text-[#004681]" : "font-medium text-[#2C2C2C]",
                    ]}
                  >
                    <span>{item.label}</span>
                    <svg
                      class="h-4 w-4 shrink-0 text-[#004681] transition-transform duration-200 group-open/accordion:rotate-180"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </summary>

                  <ul class="ml-3 space-y-1 border-l border-slate-100 py-1 pl-3">
                    {item.children?.map((entry) => (
                      <li>
                        <a href={entry.url} class="block rounded-lg px-2 py-2 text-sm text-[#2C2C2C] hover:bg-slate-50">
                          {entry.label}
                        </a>
                        {entry.children && (
                          <ul class="ml-2 space-y-1 border-l border-slate-100 py-1 pl-3">
                            {entry.children.map((child) => (
                              <li>
                                <a href={child.url} class="block rounded-lg px-2 py-2 text-sm text-[#2C2C2C] hover:bg-slate-50">
                                  {child.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            );
          })
        }
      </ul>
    </nav>

    {cta && (
      <div class="border-t border-slate-100 px-5 py-4">
        <a
          href={cta.url}
          target="_blank"
          class="flex w-full items-center justify-center gap-1.5 rounded-full bg-[#004681] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#003a6b]"
        >
          {cta.label}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    )}
  </div>
</div>

<script>
  // Panel + backdrop are toggled from here; the trigger button lives in
  // Header.astro (id="mobile-menu-button") so this listens for it globally.
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("mobile-backdrop");
  const openBtn = document.getElementById("mobile-menu-button");
  const closeBtn = document.getElementById("mobile-menu-close");

  function openMenu() {
    menu?.classList.remove("translate-x-full");
    backdrop?.classList.remove("hidden");
    requestAnimationFrame(() => backdrop?.classList.remove("opacity-0"));
    document.body.classList.add("overflow-hidden");
    openBtn?.setAttribute("aria-expanded", "true");
  }

  function closeMenu() {
    menu?.classList.add("translate-x-full");
    backdrop?.classList.add("opacity-0");
    document.body.classList.remove("overflow-hidden");
    openBtn?.setAttribute("aria-expanded", "false");
    setTimeout(() => backdrop?.classList.add("hidden"), 200);
  }

  openBtn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  backdrop?.addEventListener("click", closeMenu);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
