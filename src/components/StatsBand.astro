---
import type { SuccessStoriesPage } from '../lib/types';
import StatCard from './StatCard.astro';

interface Props {
  stats: SuccessStoriesPage['stats'];
}

const { stats } = Astro.props;
---
<section class="bg-gray-100 py-12 sm:py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-6 grid gap-8 sm:gap-10 md:grid-cols-2 items-center">
    <div>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="mb-3 text-navy/40" aria-hidden="true">
        <circle cx="12" cy="12" r="3" fill="currentColor"/>
      </svg>
      {stats.heading && <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-navy">{stats.heading}</h2>}
      {stats.description && <p class="mt-3 max-w-xs text-sm sm:text-base text-gray-500">{stats.description}</p>}
    </div>
    <div class="grid grid-cols-3 gap-2 sm:gap-4">
      {stats.items?.map((stat) => <StatCard stat={stat} />)}
    </div>
  </div>
</section>
