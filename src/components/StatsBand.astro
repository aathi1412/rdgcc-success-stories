---
import type { SuccessStoriesPage } from '../lib/types';
import StatCard from './StatCard.astro';

interface Props {
  stats: SuccessStoriesPage['stats'];
}

const { stats } = Astro.props;
---
<section class="bg-[#E8E8E8] py-8 sm:py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid lg:grid-cols-[30%_65%] md:gap-12 gap-4 items-center">
      
      <div class="text-center lg:text-left">
        {stats.heading && 
            <h2 class="text-[26px] md:text-[36px] leading-tight text-primary font-heading">
              {stats.heading}
            </h2>
          }
        {stats.description && 
            <p class="mt-4 text-md font-light text-[#2c2c2c] leading-6">
              {stats.description}
            </p>
          }
      </div>
      
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-2 sm:gap-6">
        {
          stats.items?.map((stat) => <StatCard stat={stat} />)
        }
      </div>
    </div>
  </div>
</section>
