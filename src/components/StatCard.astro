---
import type { StatItem } from '../lib/types';

interface Props {
  stat: StatItem;
}

const { stat } = Astro.props;
---
<div class="rounded-xl sm:rounded-2xl bg-white px-2 py-5 sm:px-4 sm:py-8 text-center shadow-[0_1px_3px_rgba(0,0,0,0.06)]">
  <p class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-navy">{stat.number}</p>
  <p class="mt-1 sm:mt-2 text-[11px] sm:text-sm leading-snug text-gray-500">{stat.label}</p>
</div>
