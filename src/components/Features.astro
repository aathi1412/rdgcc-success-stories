---
import type { Features as FeatureType } from '../lib/types';
import FeaturesIcon from './FeaturesIcon.astro';

interface Props {
  feature: FeatureType;
}

const { feature } = Astro.props;
---
<div class="flex items-center gap-5 rounded-3xl bg-white px-6 py-3 shadow-sm border border-slate-100">
  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/10">
    <FeaturesIcon name={feature.icon}/>
  </span>
  <p class="text-xl font-semibold text-[#004681]">{feature.title}</p>
</div>
 