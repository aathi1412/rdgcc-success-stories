---
import type { NavLink } from '../lib/types';

interface Props {
  links: NavLink[];
  currentPath?: string;
  variant?: 'desktop' | 'mobile';
}

const { links, currentPath = '', variant = 'desktop' } = Astro.props;
---
<ul class={variant === 'desktop' ? 'flex items-center gap-1' : 'flex flex-col gap-1'}>
  {links.map((link) => {
    const isActive = currentPath === link.url;
    return (
      <li>
        <a
          href={link.url}
          class:list={[
            'flex items-center gap-1 text-sm font-medium transition',
            variant === 'desktop' ? 'rounded-full px-3 py-2 lg:px-4' : 'rounded-lg px-3 py-2.5',
            isActive ? 'bg-iceblue text-navy' : 'text-gray-600 hover:text-navy',
          ]}
        >
          {link.label}
          {link.hasDropdown && (
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
        </a>
      </li>
    );
  })}
</ul>
