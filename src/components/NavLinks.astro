---
import type { NavLink } from '../lib/types';
import NavDropdown from './NavDropdown.astro';

interface Props {
  links: NavLink[];
  currentPath?: string;
}

const { links, currentPath = ''} = Astro.props;
---

<nav aria-label="Main Navigation" class="hidden items-center gap-6 lg:flex">
  {
    links.map((item) => {
      const isActive = item.url === currentPath;
      return (
        <div class="group/navitem relative">
          <a
            href={item.url}
            aria-current={isActive ? "page" : undefined}
            class:list={[
              "flex items-center gap-1 py-2 text-[#004681] transition-colors",
              isActive ? "font-bold" : "font-medium",
            ]}
          >
            <span>{item.label}</span>
            {item.children && item.children.length > 0 && (
              <svg
                class="h-3.5 w-3.5 transition-transform duration-150 group-hover/navitem:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            )}
          </a>

          {item.children && (
            <NavDropdown items={item.children} />
          )}
        </div>
      );
    })
  }
</nav>

