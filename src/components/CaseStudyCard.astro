---
import type { CaseStudyCard } from '../lib/types';
import { urlFor } from '../lib/sanity';
import Button from './Button.astro';
import CaseStudyIcon from './CaseStudyIcon.astro';

interface Props {
  card: CaseStudyCard;
}

const { card } = Astro.props;
---

<article class="flex flex-col rounded-2xl bg-white p-5 shadow-[0_1px_3px_rgba(0,0,0,0.06)] sm:p-6">

  <p class="text-xs text-gray-400">
    {card.tag}
  </p>

  <h3 class="mt-1 font-bold text-navy">
    {card.company}
  </h3>

  {card.image?.asset ? (
    <img
      src={urlFor(card.image)
        .width(400)
        .height(240)
        .fit('crop')
        .quality(80)
        .url()}
      alt={card.image.alt || `${card.company} project photo`}
      width="400"
      height="240"
      loading="lazy"
      class="mt-4 aspect-5/3 w-full rounded-xl object-cover"
    />
  ) : (
    <div
      class="mt-4 aspect-5/3 w-full rounded-xl bg-gray-100"
      role="presentation"
    ></div>
  )}
  <!-- Case study icon -->
  <span class="mt-4 flex size-8 shrink-0 items-center justify-center rounded-full bg-[#004681] text-white">
    <CaseStudyIcon name={card.icon} />
  </span>

  <h4 class="mt-4 text-base font-bold leading-snug text-brand sm:text-lg">
    {card.title}
  </h4>

  <p class="mt-2 flex-1 text-sm leading-relaxed text-gray-500">
    {card.description}
  </p>

  {card.link && (
    <Button
      cta={card.link}
      variant="link"
      class="mt-5 self-start"
    />
  )}

</article>