---
import type { CaseStudyCard as CaseStudyCardType } from '../lib/types';
import { urlFor } from '../lib/sanity';
import Button from './Button.astro';

interface Props {
  card: CaseStudyCardType;
}

const { card } = Astro.props;
---
<article class="flex flex-col rounded-2xl bg-white p-5 sm:p-6 shadow-[0_1px_3px_rgba(0,0,0,0.06)]">
  <p class="text-xs text-gray-400">{card.tag}</p>
  <h3 class="mt-1 font-bold text-navy">{card.company}</h3>

  {card.image?.asset ? (
    <img
      src={urlFor(card.image).width(400).height(240).fit('crop').quality(80).url()}
      alt={card.image.alt || `${card.company} project photo`}
      width="400"
      height="240"
      loading="lazy"
      class="mt-4 aspect-[5/3] w-full rounded-xl object-cover"
    />
  ) : (
    <div class="mt-4 aspect-[5/3] w-full rounded-xl bg-gray-100" role="presentation"></div>
  )}

  <span class="mt-4 flex h-8 w-8 items-center justify-center rounded-full bg-navy">
    {card.icon?.asset ? (
      <img src={urlFor(card.icon).width(16).height(16).url()} alt="" width="16" height="16" class="invert" />
    ) : (
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="4" y="4" width="16" height="16" rx="2" stroke="white" stroke-width="1.5"/>
      </svg>
    )}
  </span>

  <h4 class="mt-4 text-base sm:text-lg font-bold text-brand leading-snug">{card.title}</h4>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-gray-500">{card.description}</p>

  {card.link && <Button cta={card.link} variant="link" class="mt-5 self-start" />}
</article>
