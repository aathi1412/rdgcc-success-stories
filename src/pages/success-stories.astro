---
import CaseStudyGrid from "../components/case-studies-section/CaseStudyGrid.astro";
import Hero from "../components/Hero.astro";
import IntroSection from "../components/intro-section/IntroSection.astro";
import StatsBand from "../components/StatsBand.astro";
import Layout from "../layouts/Layout.astro";
import {getSuccessStoriesPage, getSiteSettings} from "../lib/getData";
import type { SuccessStoriesPage, SiteSettings } from "../lib/types";


type PageResult =
  | { 
        ok: true; 
        page: SuccessStoriesPage; 
        settings: SiteSettings | null 
    }
  | { 
        ok: false; 
        error: string 
    };

let result: PageResult;

try {
  const page = await getSuccessStoriesPage();
  const settings = await getSiteSettings();

  result = { 
    ok: true, 
    page, 
    settings 
};

} catch (err) {
  result = {
    ok: false,
    error: 'Unexpected error fetching page content.'
  };
}

---

{!result.ok ? (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <title>Success Stories — unavailable</title>
    </head>

    <body class="min-h-screen flex items-center justify-center bg-gray-50 p-6 font-body text-gray-800">
      <main class="w-full max-w-lg rounded-lg border border-gray-200 bg-white p-10 text-center shadow-sm">

        <div
          class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-[#eef4f8] text-[22px] font-semibold text-[#004681]"
        >
          !
        </div>

        <h1 class="mb-2.5 text-2xl font-semibold leading-tight text-[#12344d]">
          Content unavailable
        </h1>

        <p class="m-0 text-[15px] leading-6 text-gray-500">
          We couldn't load this page right now. Please try again later.
        </p>

        <p class="mt-5 text-[13px] leading-5 text-gray-400">
          {result.error}
        </p>

      </main>
    </body>
  </html>
) : (

    <Layout seo={result.page.seo} settings={result.settings}>
        <Hero hero={result.page.hero} />
        <IntroSection intro={result.page.intro} />
        <StatsBand stats={result.page.stats} />
        <CaseStudyGrid cards={result.page.caseStudies} />
    </Layout>
)}



