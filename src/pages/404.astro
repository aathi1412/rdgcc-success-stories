---
import Layout from "../layouts/Layout.astro";
import { getSiteSettings } from "../lib/getData";
import type { SiteSettings } from "../lib/types";

let settings: SiteSettings | null = null;

try {
  settings = await getSiteSettings();
} catch (error) {
  console.error("Failed to load site settings:", error);
}
---

<Layout settings={settings}>
  <main class="flex min-h-[60vh] items-center justify-center px-6 py-20">
    <section class="text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">
        404
      </p>

      <h1 class="mb-4 text-3xl font-bold text-[#12344d] md:text-4xl">
        Page not found
      </h1>

      <p class="mx-auto mb-8 max-w-md text-gray-500">
        This page is currently unavailable. Please visit our Success Stories to
        explore the available content.
      </p>

      <a
        href="/success-stories"
        class="inline-flex items-center rounded-md bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#00365f]"
      >
        Back to Success Stories
      </a>
    </section>
  </main>
</Layout>
